{
  "name": "kalu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client",
    "build": "npm run install:all && npm run build --prefix client",
    "start": "node server/index.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.9",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
